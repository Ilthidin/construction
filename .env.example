# Supabase project credentials (https://supabase.com/dashboard)
# URL: Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> anon / public key
SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key (server-side only, never expose)
SUPABASE_SERVICE_ROLE_KEY=

# Admin password used to log into the /admin panel
ADMIN_PASSWORD=
